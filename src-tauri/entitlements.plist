<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under Hardened Runtime or mic TCC stays denied with no usable prompt. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Required under Hardened Runtime to drive Reminders, Notes and Calendar via AppleScript.
	     Without it every write fails with -1743 ("Not authorized to send Apple events")
	     and macOS never shows the permission prompt. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
